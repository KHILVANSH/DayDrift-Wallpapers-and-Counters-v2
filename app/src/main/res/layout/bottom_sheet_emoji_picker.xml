<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose or Type Emoji"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <!-- Button to explicitly clear / set emoji to None -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNoEmoji"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚫  No Emoji (Set to None)"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:backgroundTint="@color/bg_surface_elevated"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp"
        app:cornerRadius="14dp"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Custom Emoji / Text"
            app:boxBackgroundColor="@color/bg_surface_card"
            app:boxStrokeColor="@color/primary"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCustomEmoji"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:maxLength="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyCustomEmoji"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:text="Apply"
            android:textAllCaps="false"
            android:backgroundTint="@color/primary"
            android:textColor="@color/bg_dark"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Popular Event Emojis"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEmojis"
        android:layout_width="match_parent"
        android:layout_height="220dp" />

</LinearLayout>
