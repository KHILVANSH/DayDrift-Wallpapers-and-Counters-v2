<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_wallpaper_preview" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DayDrift"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wallpapers &amp; Live Counters"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyWallpaper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Wallpaper"
            android:textAllCaps="false"
            android:backgroundTint="@color/primary"
            android:textColor="@color/bg_dark"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:textSize="12sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>

    <!-- Top Tab Segment Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabCounters"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/tab_counters"
            android:textAllCaps="false"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/bg_dark"
            android:textStyle="bold"
            app:cornerRadius="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabStudio"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/tab_studio"
            android:textAllCaps="false"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/bg_surface_elevated"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/border_card"
            app:strokeWidth="1dp"
            app:cornerRadius="22dp" />
    </LinearLayout>

    <!-- TAB 1: COUNTERS CONTAINER -->
    <FrameLayout
        android:id="@+id/containerCounters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCounters"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabNewCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:text="@string/action_add_counter"
            android:textColor="@color/bg_dark"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            app:icon="@android:drawable/ic_input_add"
            app:iconTint="@color/bg_dark" />
    </FrameLayout>

    <!-- TAB 2: WALLPAPER STUDIO CONTAINER -->
    <ScrollView
        android:id="@+id/containerStudio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Phone Screen Mockup Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="14dp">

                <FrameLayout
                    android:id="@+id/phoneMockupFrame"
                    android:layout_width="230dp"
                    android:layout_height="440dp"
                    android:background="@drawable/bg_card"
                    android:elevation="6dp"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <TextureView
                        android:id="@+id/studioVideoTextureView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <com.daydrift.app.view.LiveWallpaperPreviewView
                        android:id="@+id/studioPreviewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Top Bar Inside Phone Mockup: Enlarge button & Lock button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="top"
                        android:padding="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleTouchLock"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="🔒 Locked"
                            android:textAllCaps="false"
                            android:textSize="10sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:backgroundTint="#CC131824"
                            android:textColor="@color/text_secondary"
                            app:strokeColor="@color/border_card"
                            app:strokeWidth="1dp"
                            app:cornerRadius="12dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEnlargePreview"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Enlarge ⤢"
                            android:textAllCaps="false"
                            android:textSize="10sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:backgroundTint="#CC131824"
                            android:textColor="@color/text_primary"
                            app:strokeColor="@color/border_card"
                            app:strokeWidth="1dp"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                </FrameLayout>
            </LinearLayout>

            <!-- Unsaved Changes Action Bar -->
            <LinearLayout
                android:id="@+id/barUnsavedChanges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvUnsavedNotice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Unsaved Wallpaper Changes"
                    android:textColor="@color/accent_amber"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiscardChanges"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Discard"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="@color/bg_surface_elevated"
                    app:cornerRadius="10dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveChanges"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Save Changes"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/bg_dark"
                    android:backgroundTint="@color/primary"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- Background Menu Selector (Dropdown Menu) -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Wallpaper Background Type"
                app:boxBackgroundColor="@color/bg_surface_elevated"
                app:boxStrokeColor="@color/primary"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                android:layout_marginBottom="14dp">

                <AutoCompleteTextView
                    android:id="@+id/menuBackgroundType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Gradient controls container -->
            <LinearLayout
                android:id="@+id/panelGradientControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvBgAngle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gradient Angle: 135°"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderBgAngle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="360"
                    android:value="135"
                    android:stepSize="15"
                    app:thumbColor="@color/primary"
                    app:trackColorActive="@color/primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBgStartColor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Start Color"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBgEndColor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="End Color"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Solid Color Picker Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickSolidColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose Solid Color"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                android:visibility="gone"
                android:layout_marginBottom="14dp" />

            <!-- Unsplash Search Panel -->
            <LinearLayout
                android:id="@+id/panelUnsplash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Search Unsplash (e.g. AMOLED, Nature)"
                        app:boxBackgroundColor="@color/bg_surface_card"
                        app:boxStrokeColor="@color/primary"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputUnsplashQuery"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSearchUnsplash"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:text="Search"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/primary"
                        android:textColor="@color/bg_dark"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerUnsplash"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Video Live Wallpaper Panel -->
            <LinearLayout
                android:id="@+id/panelVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Video Live Wallpaper"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvVideoStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select any video (.mp4, .mkv) to loop smoothly as your live wallpaper."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose Video from Gallery"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/secondary"
                    android:textColor="@color/white"
                    app:cornerRadius="14dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
