<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@color/bg_surface_card">

    <!-- Preview Container: Shows Icon, Mini Phone Graphic, or Gradient Swatch -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_preview_swatch">

        <ImageView
            android:id="@+id/ivPreviewIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center" />

        <View
            android:id="@+id/vPreviewSwatch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Mini Phone Screen Position Graphic -->
        <FrameLayout
            android:id="@+id/vMiniPhoneFrame"
            android:layout_width="24dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill"
            android:visibility="gone">

            <!-- Glowing Position Dot Indicator -->
            <View
                android:id="@+id/vPositionDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_pill_active" />
        </FrameLayout>
    </FrameLayout>

    <!-- Title and Subtitle Description -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDropdownTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDropdownSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Badge / Tag -->
    <TextView
        android:id="@+id/tvDropdownBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/primary"
        android:textSize="11sp"
        android:background="@drawable/bg_chip_surface"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_marginStart="8dp" />

</LinearLayout>
