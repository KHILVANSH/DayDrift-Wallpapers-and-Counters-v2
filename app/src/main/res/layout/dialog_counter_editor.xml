<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/dialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Configure Countdown"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseDialog"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="✕"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:backgroundTint="@color/bg_surface_elevated"
                app:cornerRadius="20dp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Live Real-Time Counter Preview Card -->
        <FrameLayout
            android:id="@+id/editorPreviewCard"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="18dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <com.daydrift.app.view.LiveWallpaperPreviewView
                android:id="@+id/editorPreviewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE PREVIEW"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="#CC131824"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_gravity="top|start"
                android:layout_margin="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestAnimation"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="▶ Replay Animation"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:backgroundTint="#CC131824"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp" />
        </FrameLayout>

        <!-- Mode Segmented Switch: Countdown vs Count-Up -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="6dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeCountdown"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="⏳ Countdown"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:textColor="@color/bg_dark"
                app:cornerRadius="12dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeCountUp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="⏱️ Count-Up (Since)"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/bg_surface_elevated"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Card 1: Title, Emoji, and Visibility -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Event Title"
                app:boxBackgroundColor="@color/bg_surface_card"
                app:boxStrokeColor="@color/primary"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Show Title Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display Title on Wallpaper"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toggle title visibility over wallpaper"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchShowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/primary"
                    app:trackTint="@color/bg_surface_elevated" />
            </LinearLayout>

            <!-- Emoji Selection Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Emoji / Icon"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmojiPicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎯  Choose Emoji"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/bg_surface_elevated"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemoveEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚫  None"
                    android:textAllCaps="false"
                    android:textColor="@color/error"
                    android:backgroundTint="@color/bg_surface_elevated"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 2: Date & Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Date &amp; Time"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDatePicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Select Date"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/bg_surface_elevated"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTimePicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Select Time"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/bg_surface_elevated"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 3: Layout Style Dropdown & Position Preset Dropdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Layout &amp; Placement"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrowseLayouts"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Visual Cards ⤢"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:backgroundTint="@color/bg_surface_elevated"
                    android:textColor="@color/primary"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp" />
            </LinearLayout>

            <!-- Layout Style Dropdown Menu -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Countdown Layout Style"
                app:boxBackgroundColor="@color/bg_surface_elevated"
                app:boxStrokeColor="@color/primary"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                android:layout_marginBottom="14dp">

                <AutoCompleteTextView
                    android:id="@+id/menuLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Animation Style Dropdown Menu -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Transition Animation"
                app:boxBackgroundColor="@color/bg_surface_elevated"
                app:boxStrokeColor="@color/primary"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                android:layout_marginBottom="14dp">

                <AutoCompleteTextView
                    android:id="@+id/menuAnimationStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Position Preset Dropdown Menu -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Position Preset"
                app:boxBackgroundColor="@color/bg_surface_elevated"
                app:boxStrokeColor="@color/primary"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                android:layout_marginBottom="14dp">

                <AutoCompleteTextView
                    android:id="@+id/menuPositionPreset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Font Selector Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectFont"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Typography Font: Sans-Serif Bold (100+ Available)"
                android:textAllCaps="false"
                android:backgroundTint="@color/bg_surface_elevated"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_font"
                app:iconTint="@color/primary"
                app:iconGravity="textStart"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- Card 4: Countdown Colors & Gradients -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color &amp; Gradient Engine"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Color Format Dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Digit Color Format"
                app:boxBackgroundColor="@color/bg_surface_elevated"
                app:boxStrokeColor="@color/primary"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                android:layout_marginBottom="12dp">

                <AutoCompleteTextView
                    android:id="@+id/menuColorFormat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Solid Color Picker Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSolidCountColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose Solid Color"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Gradient Options Container -->
            <LinearLayout
                android:id="@+id/layoutCountGradientOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCountGradAngle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gradient Angle: 45°"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderCountGradAngle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="360"
                    android:value="45"
                    android:stepSize="15"
                    app:thumbColor="@color/primary"
                    app:trackColorActive="@color/primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCountStartColor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Start Color"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCountEndColor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="End Color"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Save and Cancel Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:backgroundTint="@color/bg_surface_elevated"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2"
                android:layout_marginStart="8dp"
                android:text="Save Countdown"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:textColor="@color/bg_dark"
                app:cornerRadius="14dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
